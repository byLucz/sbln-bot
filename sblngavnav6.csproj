<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
	<Nullable>disable</Nullable>
	<NoWarn>$(NoWarn);CS1998</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Audio8\countdown.mp3" Link="audio\countdown.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="external\**\*.cs" />
    <Content Remove="external\**" />
    <None Remove="external\**" />
    <EmbeddedResource Remove="external\**" />
    <Compile Remove="TelegramExtensions\**\*.cs" />
    <Content Remove="TelegramExtensions\**" />
    <None Remove="TelegramExtensions\**" />
    <EmbeddedResource Remove="TelegramExtensions\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="external\DTF\DTF.csproj" />
    <ProjectReference Include="TelegramExtensions\TelegramExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lavalink4NET.Discord.NET" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.2.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NLayer" Version="1.11.0" NoWarn="NU1701" />
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="MySqlConnector" Version="2.6.0" />
    <PackageReference Include="TwitchLib.Api" Version="3.10.2" />
  </ItemGroup>

</Project>
