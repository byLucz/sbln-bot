<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
	<Nullable>disable</Nullable>
	<NoWarn>$(NoWarn);CS1998</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Audio8\countdown.mp3" Link="audio\countdown.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\Assets\**" Link="images\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="external\**\*.cs" />
    <Content Remove="external\**" />
    <None Remove="external\**" />
    <EmbeddedResource Remove="external\**" />
    <Compile Remove="TelegramExtensions\**\*.cs" />
    <Content Remove="TelegramExtensions\**" />
    <None Remove="TelegramExtensions\**" />
    <EmbeddedResource Remove="TelegramExtensions\**" />
    <None Remove=".dockerignore;.editorconfig;.gitignore;.gitmodules;Dockerfile;docker-compose.yml;install.sh;README.md;sbln.sh;sblnproto.sh;agent\**;config\**;.github\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="external\DTF\DTF.csproj" />
    <ProjectReference Include="TelegramExtensions\TelegramExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lavalink4NET.Discord.NET" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.2.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="NLayer" Version="3.0.1" NoWarn="NU1701" />
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageReference Include="TwitchLib.Api" Version="3.11.0" />
  </ItemGroup>

</Project>
